{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "psyc-thesis-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-15",
  "workers_dev": true,
  "observability": {"enabled": false},
  "d1_databases": [{
    "binding": "DB",
    "database_name": "psyc-thesis-research",
    "database_id": "REPLACE_WITH_REAL_RESEARCH_D1_DATABASE_ID",
    "migrations_dir": "migrations"
  }, {
    "binding": "CONTACTS_DB",
    "database_name": "psyc-thesis-draw",
    "database_id": "REPLACE_WITH_REAL_CONTACTS_D1_DATABASE_ID",
    "migrations_dir": "contact-migrations"
  }]
}
